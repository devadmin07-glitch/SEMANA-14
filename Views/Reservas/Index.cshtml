@model List<HotelReservasMVC.Models.Reserva>
@{ ViewData["Title"]="Historial reservas"; }
<div class="page-title">
<div class="eyebrow">HOTEL · REGISTROS GUARDADOS</div>
<h1>Historial de reservas</h1>
<p>Últimas 50 reservas, ordenadas del número más reciente al anterior.</p></div>
<section class="panel"><div class="actions end"><a asp-action="Nueva" class="btn btn-primary">+ Generar reserva</a></div><div class="table-scroll"><table><thead><tr><th>N.º</th><th>Cliente</th><th>Llegada</th><th>Salida</th><th>Habitaciones</th><th>Total</th><th></th></tr></thead><tbody>
@if(Model.Count==0){<tr><td colspan="7" class="empty">No hay reservas registradas.</td></tr>}
@foreach(var r in Model){<tr><td>#@r.Id</td><td>@r.Cliente.NombreCompleto</td><td>@r.FechaLlegada.ToString("dd/MM/yyyy")</td><td>@r.FechaSalida.ToString("dd/MM/yyyy")</td><td>@r.Detalles.Count</td><td>S/ @r.Total.ToString("N2")</td>

<td>
    <a asp-action="Detalle"
       asp-route-id="@r.Id"
       class="small-link">
        Ver detalle
    </a>

    <a asp-action="Editar"
       asp-route-id="@r.Id"
       class="btn btn-secondary btn-sm">
        Editar
    </a>

    <form asp-action="Eliminar"
          asp-route-id="@r.Id"
          method="post"
          style="display:inline"
          onsubmit="return confirm('¿Seguro que deseas eliminar esta reserva?');">

        @Html.AntiForgeryToken()

        <button type="submit" class="remove-btn">
            Eliminar
        </button>
    </form>
</td>
</tr>}
</tbody></table></div></section>


